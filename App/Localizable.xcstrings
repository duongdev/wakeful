    "Wakeful is off or on with no end time, so there is no time to change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful ist aus oder läuft ohne Endzeit, daher gibt es keine Zeit zum Ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful está desactivado o activado sin hora de fin, así que no hay tiempo que cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful est désactivé ou activé sans heure de fin : il n’y a pas de temps à modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful è disattivato o attivo senza orario di fine, quindi non c’è tempo da cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakefulがオフ、または終了時刻なしでオンのため、変更できる時間がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful이 꺼져 있거나 종료 시간 없이 켜져 있어 변경할 시간이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Wakeful está desativado ou ativado sem horário de término, então não há tempo para alterar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful выключен или включен без времени окончания, поэтому менять нечего."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful đang tắt hoặc đang bật không có giờ kết thúc, nên không có thời gian để thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful 已关闭或开启但没有结束时间，因此没有可更改的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful 已關閉或開啟但沒有結束時間，因此沒有可更改的時間。"
          }
        }
      }
    },
