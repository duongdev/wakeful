    "Adds time to the running session, or removes it with a negative value. Fails when Wakeful is off or on with no end time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt der laufenden Sitzung Zeit hinzu oder entfernt sie mit einem negativen Wert. Schlägt fehl, wenn Wakeful aus ist oder ohne Endzeit läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tiempo a la sesión en curso, o lo quita con un valor negativo. Falla si Wakeful está desactivado o activado sin hora de fin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute du temps à la session en cours, ou en retire avec une valeur négative. Échoue si Wakeful est désactivé ou activé sans heure de fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge tempo alla sessione in corso, o lo toglie con un valore negativo. Non riesce se Wakeful è disattivato o attivo senza orario di fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のセッションに時間を追加します。負の値の場合は減らします。Wakefulがオフ、または終了時刻なしでオンの場合は失敗します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 세션에 시간을 추가하거나, 음수 값이면 줄입니다. Wakeful이 꺼져 있거나 종료 시간 없이 켜져 있으면 실패합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona tempo à sessão em andamento, ou remove com um valor negativo. Falha quando o Wakeful está desativado ou ativado sem horário de término."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет время к текущему сеансу или убирает его при отрицательном значении. Не работает, если Wakeful выключен или включен без времени окончания."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm thời gian vào phiên đang chạy, hoặc bớt đi nếu là số âm. Không chạy được khi Wakeful đang tắt hoặc đang bật không có giờ kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为正在进行的会话增加时间，负值则减少时间。Wakeful 关闭或开启但没有结束时间时会失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為正在進行的工作階段增加時間，負值則減少時間。Wakeful 關閉或開啟但沒有結束時間時會失敗。"
          }
        }
      }
    },
