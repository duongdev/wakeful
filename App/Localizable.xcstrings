    "Turns Wakeful on if it is off, or off if it is on. With no duration, Wakeful uses your default duration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Wakeful ein, wenn es aus ist, oder aus, wenn es an ist. Ohne Dauer verwendet Wakeful deine Standarddauer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Wakeful si está desactivado, o lo desactiva si está activado. Sin duración, Wakeful usa tu duración predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active Wakeful s’il est désactivé, ou le désactive s’il est activé. Sans durée, Wakeful utilise votre durée par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Wakeful se è disattivato, o lo disattiva se è attivo. Senza durata, Wakeful usa la durata predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakefulがオフならオンに、オンならオフにします。時間がない場合は、デフォルトの時間を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful이 꺼져 있으면 켜고, 켜져 있으면 끕니다. 기간이 없으면 기본 기간을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa o Wakeful se estiver desativado, ou desativa se estiver ativado. Sem duração, o Wakeful usa sua duração padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает Wakeful, если он выключен, или выключает, если включен. Без длительности Wakeful использует длительность по умолчанию."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Wakeful nếu đang tắt, hoặc tắt nếu đang bật. Nếu không có thời lượng, Wakeful dùng thời lượng mặc định của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful 关闭时开启，开启时关闭。没有时长时，Wakeful 使用默认时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wakeful 關閉時開啟，開啟時關閉。沒有時長時，Wakeful 使用預設時長。"
          }
        }
      }
    },
