    "Returns the time left in the session. Returns nothing when Wakeful is off or on with no end time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt die Restzeit der Sitzung zurück. Gibt nichts zurück, wenn Wakeful aus ist oder ohne Endzeit läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el tiempo restante de la sesión. No devuelve nada si Wakeful está desactivado o activado sin hora de fin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie le temps restant de la session. Ne renvoie rien si Wakeful est désactivé ou activé sans heure de fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce il tempo rimanente della sessione. Non restituisce nulla se Wakeful è disattivato o attivo senza orario di fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションの残り時間を返します。Wakefulがオフ、または終了時刻なしでオンの場合は何も返しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션의 남은 시간을 반환합니다. Wakeful이 꺼져 있거나 종료 시간 없이 켜져 있으면 아무것도 반환하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna o tempo restante da sessão. Não retorna nada quando o Wakeful está desativado ou ativado sem horário de término."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает оставшееся время сеанса. Ничего не возвращает, если Wakeful выключен или включен без времени окончания."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả về thời gian còn lại của phiên. Không trả về gì khi Wakeful đang tắt hoặc đang bật không có giờ kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回会话的剩余时间。Wakeful 关闭或开启但没有结束时间时不返回任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳回工作階段的剩餘時間。Wakeful 關閉或開啟但沒有結束時間時不傳回任何內容。"
          }
        }
      }
    },
