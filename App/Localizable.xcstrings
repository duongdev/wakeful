    "You unplugged the charger. Your Mac can sleep normally now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das Ladegerät getrennt. Dein Mac kann jetzt wieder normal ruhen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconectaste el cargador. Ahora el Mac puede entrar en reposo con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez débranché le chargeur. Votre Mac peut maintenant se mettre en veille normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scollegato il caricabatterie. Ora il Mac può andare in stop normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充電器が外されました。Macは通常どおりスリープできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충전기를 분리했습니다. 이제 Mac이 정상적으로 잠자기 상태에 들어갈 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desconectou o carregador. Agora o Mac pode repousar normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отключили зарядку. Теперь Mac может спать как обычно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã rút sạc. Máy Mac giờ có thể ngủ bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拔下了充电器。现在 Mac 可以正常睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拔下了充電器。現在 Mac 可以正常睡眠。"
