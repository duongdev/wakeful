    "(Logs were copied to your clipboard. Paste them here.)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Die Protokolle wurden in die Zwischenablage kopiert. Füge sie hier ein.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Los registros se copiaron al portapapeles. Pégalos aquí)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Les journaux ont été copiés dans le presse-papiers. Collez-les ici.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(I log sono stati copiati negli appunti. Incollali qui.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(ログをクリップボードにコピーしました。ここにペーストしてください。)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(로그가 클립보드에 복사되었습니다. 여기에 붙여 넣으세요.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Os registros foram copiados para a área de transferência. Cole-os aqui.)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Журналы скопированы в буфер обмена. Вставьте их сюда.)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Nhật ký đã được sao chép vào bảng nhớ tạm. Hãy dán vào đây.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(日志已拷贝到剪贴板。请粘贴到这里。)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(日誌已拷貝到剪貼板。請貼上到這裡。)"
          }
        }
      }
    },
    "A past time today means tomorrow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine heute schon vergangene Uhrzeit bedeutet morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hora ya pasada hoy significa mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une heure déjà passée aujourd’hui signifie demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un orario già passato oggi indica domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日すでに過ぎた時刻は明日を意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이미 지난 시간은 내일을 뜻합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um horário que já passou hoje significa amanhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прошедшее сегодня время означает завтра."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ đã qua trong hôm nay được tính là ngày mai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天已过的时间表示明天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天已過的時間表示明天。"
          }
        }
      }
    },
